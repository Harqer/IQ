FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 \
    HF_HOME=/data/hf HOME=/tmp
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 ca-certificates && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-local.txt /app/requirements-local.txt
# Install the CPU wheel first so torch>=2.10 in requirements-local.txt does not
# pull the larger default CUDA-enabled distribution into the container.
RUN python -m pip install --upgrade pip && \
    python -m pip install --index-url https://download.pytorch.org/whl/cpu 'torch>=2.10,<3' && \
    python -m pip install -r requirements-local.txt
COPY . /app
# OpenShift may run this image with a random UID in root group.
RUN chgrp -R 0 /app && chmod -R g=u /app
CMD ["python", "scripts/verify_iq_full_inference.py", "--manifest-only"]
