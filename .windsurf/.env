# Foundational Behavioral Guidelines Environment
# These settings make guidelines always active by default

BEHAVIORAL_GUIDELINES_MODE=foundational
GUIDELINES_AUTO_ACTIVATE=true
NO_CONFIGURATION_REQUIRED=true
BIAS_TOWARD_CAUTION=true
CONTINUOUS_MONITORING=true

# These are always on - no flags needed
THINK_BEFORE_CODING=true
SIMPLICITY_FIRST=true
SURGICAL_CHANGES=true
GOAL_DRIVEN_EXECUTION=true
