# Quantum Hardware API Configuration
# Copy this file to .env.quantum and fill in your API keys

# ============================================================================
# CUDA-Q Configuration (NVIDIA H200)
# ============================================================================
CUDA_Q_API_KEY=your_cuda_q_api_key_here
CUDA_Q_ENDPOINT=http://your-thunder-compute-endpoint:8000
CUDA_Q_DEVICE=nvidia-h200

# ============================================================================
# IBM Quantum Configuration
# ============================================================================
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here
IBM_QUANTUM_DEVICE=ibm_brisbane

# Available IBM Quantum devices (2026):
# - ibm_brisbane: 127 qubits (Heron)
# - ibm_sherbrooke: 127 qubits (Heron)
# - ibm_fez: 133 qubits (Eagle)
# - ibm_kyoto: 127 qubits (Heron)
# - ibm_osaka: 127 qubits (Heron)

# ============================================================================
# IonQ Configuration
# ============================================================================
IONQ_API_KEY=your_ionq_api_key_here
IONQ_DEVICE=ionq_qpu

# Available IonQ devices (2026):
# - ionq_qpu: 36 qubits (trapped ions)
# - ionq_simulator: 29 qubits (simulated)

# ============================================================================
# Rigetti Configuration
# ============================================================================
RIGETTI_API_KEY=your_rigetti_api_key_here
RIGETTI_DEVICE=aspen-m-3

# Available Rigetti devices (2026):
# - aspen-m-3: 80 qubits (superconducting)
# - aspen-11: 40 qubits (superconducting)

# ============================================================================
# General Settings
# ============================================================================
DEFAULT_QUANTUM_BACKEND=cuda_q
FALLBACK_TO_CLASSICAL=true
MAX_PARALLEL_JOBS=4
TIMEOUT_SECONDS=300
